# A sourced file is looked up from the working directory, which is the
# repository root under tests/run.sh, and then from SCRIPTDIR. SCRIPTDIR is the
# directory of the script being checked, also inside a file that script
# sources. A library that names a neighbour by its bare name can therefore read
# a test of that name, or nothing, from a script outside scripts/lib. So a file
# that a checked script reaches through another file is named in full from the
# repository root: tests/engine-vagrant.sh reaches scripts/lib/config.sh
# through scripts/lib/common.sh, and the files common.sh sources must not be
# read as tests/config.sh or tests/engine-vagrant.sh.
external-sources=true
source-path=SCRIPTDIR

# Disabled everywhere, each for a reason that holds everywhere:
#
# SC2154  CFG_* are assigned by flth_config_load through `printf -v`,
#         which shellcheck cannot see.
# SC2317  functions called only indirectly — trap handlers, stubs, and
#         functions a test shadows — read as unreachable.
# SC2016  the tests write scripts whose `$` must reach the script
#         unexpanded; single quotes are the point.
disable=SC2154,SC2317,SC2016
