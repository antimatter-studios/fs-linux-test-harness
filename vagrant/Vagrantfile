# fs-linux-test-harness — the test VM.
#
# Driven ONLY through scripts/vm.sh (chore vm:*), which exports every
# FLTH_* value read below and points VAGRANT_DOTFILE_PATH at the
# consumer's machine directory. Run `vagrant` here by hand and it stops
# at the first missing value, by design.
#
# THE GUEST ARCHITECTURE IS THE HOST'S, and so is the accelerator. There
# is no emulated path: a VM run in software is a test suite that takes an
# hour and times out somewhere unhelpful.
#
#   macOS arm64    HVF   box christhomas/vagrant-rpi-bookworm-arm64
#                        plugins vagrant-qemu-christhomas and
#                        vagrant-notify-forwarder-christhomas (forks that
#                        fix problems specific to the Mac)
#   Linux aarch64  KVM   box cloud-image/debian-12 (arm64); stock
#                        vagrant-qemu; UEFI firmware from FLTH_QEMU_DIR
#   Linux x86_64   KVM   box cloud-image/debian-12 (amd64); stock
#                        vagrant-qemu; SeaBIOS; q35
#
# NOTHING IS SHARED AT BOOT (#222). The guest is shared by every consumer on
# the host, and each run attaches its own tree while the guest runs: a
# vhost-user-fs device served by a virtiofsd of its own, hot-plugged into one
# of the free pcie-root-ports reserved below (scripts/lib/engine-vagrant.sh,
# engine_attach_tree). The same on every host; 9p cannot do it, because QEMU
# has no way to add a 9p device's backend at runtime.
#
# NOTHING FILESYSTEM-SPECIFIC BELONGS HERE. The consumer's setup script,
# run inside the guest by scripts/vm.sh, installs its own tooling.

require "digest"
require "rbconfig"
require "uri"

def flth_env(name, pattern, what)
  value = ENV[name]
  if value.nil? || value.empty?
    raise "#{name} is not set. This Vagrantfile is driven by fs-linux-test-harness " \
          "(chore vm:up / scripts/vm.sh), not by running vagrant directly."
  end
  # \A and \z, NOT ^ and $: Ruby's ^ and $ match at line boundaries, so
  # /^[0-9]+$/ accepts "480\nrm -rf /". Several of these values reach a
  # QEMU command line or a root shell in the guest.
  raise "#{name} must be #{what}, got #{value.inspect}" unless value =~ pattern
  value
end

# A plugin can arrive two ways: `vagrant plugin install`, or a bundler
# Gemfile's :plugins group when Vagrant runs from source (the only way to
# get a current Vagrant on linux-arm64). has_plugin? sees only the first.
def flth_plugin?(name)
  Vagrant.has_plugin?(name) || Gem.loaded_specs.key?(name)
end

def flth_require_plugin(name, why)
  return if flth_plugin?(name)
  raise "Required Vagrant plugin #{name} is missing (#{why}). " \
        "Install it: vagrant plugin install #{name}"
end

host_os  = RbConfig::CONFIG["host_os"]
host_cpu = RbConfig::CONFIG["host_cpu"]

host =
  if host_os =~ /darwin/ && host_cpu =~ /\A(arm64|aarch64)/
    :macos_arm64
  elsif host_os =~ /linux/ && host_cpu =~ /\A(arm64|aarch64)/
    :linux_arm64
  elsif host_os =~ /linux/ && host_cpu =~ /\Ax86_64\z/
    :linux_x86_64
  else
    raise "fs-linux-test-harness supports macOS arm64, Linux aarch64 and Linux x86_64 hosts; " \
          "this is #{host_os} #{host_cpu}"
  end

vm_name   = flth_env("FLTH_VM_NAME", /\A[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\z/, "a hostname label")
guest     = flth_env("FLTH_VM_GUEST", /\Adebian-1[23]\z/, "debian-12 or debian-13")
memory    = flth_env("FLTH_VM_MEMORY", /\A[1-9][0-9]{0,5}[MG]\z/, "a size like 4G or 2048M")
cpus      = flth_env("FLTH_VM_CPUS", /\A[1-9][0-9]?\z/, "an integer from 1 to 99")
disk      = flth_env("FLTH_VM_DISK", /\A[1-9][0-9]{0,4}G\z/, "a size like 32G")
ssh_port  = flth_env("FLTH_VM_SSH_PORT", /\A[1-9][0-9]{3,4}\z/, "a port number")
deadline  = flth_env("FLTH_VM_DEADLINE_MINUTES", /\A[1-9][0-9]{0,5}\z/, "a positive integer of at most six digits")
qmp       = flth_env("FLTH_VM_QMP", %r{\A/[A-Za-z0-9._/-]*\z}, "an absolute path")
slots     = Integer(flth_env("FLTH_VM_SLOTS", /\A[1-9][0-9]?\z/, "an integer from 1 to 64"), 10)
raise "FLTH_VM_SLOTS must be an integer from 1 to 64, got #{slots}" if slots > 64
disposable = flth_env("FLTH_VM_DISPOSABLE", /\A[01]\z/, "1 (a disposable boot) or 0 (a provisioning boot)") == "1"
console_log = flth_env("FLTH_VM_CONSOLE_LOG", %r{\A/[A-Za-z0-9._/ -]*\z}, "an absolute path")

# WHERE A RUN'S TREE IS ATTACHED (#222). QEMU refuses to hot-plug a device into
# pcie.0, so free pcie-root-ports are reserved at boot, one per tree that can be
# attached at once. io-reserve=0, or the 64 KiB of IO space runs out at about ten
# ports. Packed eight to a device number, multifunction, from 0x11, clear of the
# cache disk at 0x10 and of the q35 chipset at 0x1f. Each port has a chassis and
# slot of its own, which is the name the guest gives its slot.
#
# virtiofsd reaches the guest's memory only through a memory backend with
# share=on: a memfd on Linux, and on macOS a file in FLTH_VM_MEM_DIR, which QEMU
# creates and unlinks at once when mem-path is a directory. The macOS provider used
# to add one only for its own boot-time folders.
#
# QMP is how a device is added and removed, and how the harness asks which are
# there.
slot_addr = ->(i) { format("0x%x.%d", 0x11 + (i - 1) / 8, (i - 1) % 8) }
port_args = (1..slots).flat_map do |i|
  multifunction = ((i - 1) % 8).zero? ? ",multifunction=on" : ""
  ["-device", "pcie-root-port,id=flth_rp#{i},bus=pcie.0,chassis=#{i},slot=#{i},io-reserve=0,addr=#{slot_addr.call(i)}#{multifunction}"]
end
memory_backend =
  if host == :macos_arm64
    mem_dir = flth_env("FLTH_VM_MEM_DIR", %r{\A/[A-Za-z0-9._/-]*\z}, "an absolute path")
    "memory-backend-file,id=flth_mem,size=#{memory},mem-path=#{mem_dir},share=on"
  else
    "memory-backend-memfd,id=flth_mem,size=#{memory},share=on"
  end
hotplug_args = ["-object", memory_backend, "-numa", "node,memdev=flth_mem"] + port_args +
               ["-qmp", "unix:#{qmp},server=on,wait=off"]

# THE GUEST'S SERIAL CONSOLE, KEPT IN A FILE (#61). The provider sends
# it to a Unix socket nobody reads (`-chardev socket,id=ser0` and
# `-serial chardev:ser0`, in the stock provider and the macOS fork alike),
# and the guest's kernel writes there (console=ttyS0 on the Linux box).
# So a boot that never answered SSH said nothing about why. `-set` adds
# QEMU's own log to that chardev rather than replacing it: the provider's
# socket stays, QEMU writes the log whether or not anything is connected
# to it, and it starts afresh with each QEMU. It works because the
# provider defines ser0 before it appends extra_qemu_args. The value is
# not split on commas, so the path needs no escaping. scripts/vm.sh
# prints its tail when a boot fails.
console_args = ["-set", "chardev.ser0.logfile=#{console_log}", "-set", "chardev.ser0.logappend=off"]

# THE DECLARED CACHE (#39): a raw disk image scripts/lib/engine-vagrant.sh
# makes in the machine directory when the consumer's config has a [cache]
# section, and the only thing a disposable boot writes that outlives it.
# Empty when none is declared; optional, unlike every value above, because
# most consumers keep nothing.
#
# IT IS ATTACHED THROUGH extra_qemu_args, NEVER AS A PROVIDER DISK. The
# provider applies extra_drive_args — snapshot=on on a disposable boot —
# to every drive it attaches, its extra disks included, and a cache that
# reached that list would be discarded with the run it exists to outlive.
# The serial is how the guest finds it: /dev/disk/by-id/virtio-<serial>,
# whatever order the disks were probed in. At most 20 characters.
#
# ITS PCI SLOT IS FIXED, AFTER THE MACHINE'S OWN DISK. QEMU creates every
# -device before the device an `-drive if=virtio` implies, so a cache
# left to take the next free slot was found ahead of the provider's disk.
# A BIOS boots the first disk it finds, and on Linux x86_64 that was the
# empty cache: the guest never came up. Slot 0x10 is free on q35 and on
# virt, and above every slot the provider's own devices are given.
cache_disk = ENV["FLTH_VM_CACHE_DISK"].to_s
unless cache_disk.empty? || cache_disk =~ %r{\A/[A-Za-z0-9._/ -]*\z}
  raise "FLTH_VM_CACHE_DISK must be an absolute path, got #{cache_disk.inspect}"
end
cache_guest = "/cache"
cache_id = "flth_cache"
cache_serial = "flth-cache"
cache_args =
  if cache_disk.empty?
    []
  else
    %W(
      -drive if=none,id=#{cache_id},file=#{cache_disk.gsub(",", ",,")},format=raw
      -device virtio-blk-pci,drive=#{cache_id},serial=#{cache_serial},addr=0x10
    )
  end

# THE KERNEL A PROVISIONING BOOT LEFT ON THE DISK, ON macOS (#80). The box
# has no bootloader in its boot path: its own Vagrantfile sets
# firmware_format = nil and passes -kernel and -initrd naming files beside the
# box, so a kernel installed in the guest is never run. The harness copies the
# disk's newest kernel out when a provisioning boot ends
# (scripts/lib/engine-vagrant.sh, engine_keep_kernel) and names it here. The
# provider puts the box's arguments first when it merges the two, and QEMU
# takes the last -kernel and -initrd it is given. A run profile also captures
# the root command line and supplies -append; this enables exact direct boots on
# Linux too. Without it a Linux guest keeps choosing its kernel through GRUB.
# Optional, like the cache: empty until a preparation boot leaves a kernel.
boot_files = %w[FLTH_VM_BOOT_KERNEL FLTH_VM_BOOT_INITRD].map do |name|
  value = ENV[name].to_s
  unless value.empty? || value =~ %r{\A/[A-Za-z0-9._/ -]*\z}
    raise "#{name} must be an absolute path, got #{value.inspect}"
  end
  value
end
boot_kernel, boot_initrd = boot_files
kernel_args = boot_kernel.empty? ? [] : ["-kernel", boot_kernel, "-initrd", boot_initrd]
boot_cmdline = ENV["FLTH_VM_BOOT_CMDLINE"].to_s
unless boot_cmdline.empty?
  raise "FLTH_VM_BOOT_CMDLINE needs a kernel and initrd" if boot_kernel.empty? || boot_initrd.empty?
  raise "FLTH_VM_BOOT_CMDLINE must be one printable line" unless boot_cmdline =~ /\A[ -~]+\z/
  kernel_args += ["-append", boot_cmdline]
end

# A DISPLAY DEVICE ON x86_64 (#70). The provider passes `-vga none`, and
# the Debian 13 box's GRUB then never hands over to its kernel: it prints
# `Booting 'Debian GNU/Linux'`, the machine resets, and GRUB starts again,
# with not one line of kernel output. Measured on the KVM runner (the
# kvm-probe workflow's debian-13-boot job): the box under plain QEMU
# boots; add only `-vga none` and it resets 384 times in a minute; add
# `-vga std` after it and it boots again. The other additions the harness
# makes (the shares, the cache disk at 0x10, `-parallel none`) change
# nothing. Debian 12 boots either way. A later `-vga` replaces an earlier
# one, so this gives the guest a standard VGA it never shows anywhere
# (`-display none`), and its console is still the serial port.
display_args = (host == :linux_x86_64 ? %w(-vga std) : [])

case host
when :macos_arm64
  flth_require_plugin("vagrant-qemu-christhomas", "the QEMU provider used on macOS")
  # DO NOT disable the notify forwarder. With it disabled the plugin's
  # `up` hook truncates the boot chain: the VM imports and then never
  # boots, with no error printed.
  flth_require_plugin("vagrant-notify-forwarder-christhomas", "required companion of the macOS QEMU provider")
when :linux_arm64, :linux_x86_64
  flth_require_plugin("vagrant-qemu", "the stock QEMU provider used on Linux")
  kvm = "/dev/kvm"
  unless File.exist?(kvm) && File.readable?(kvm) && File.writable?(kvm)
    raise "#{kvm} is missing or not read-write for this user. KVM is required; " \
          "software emulation is refused. Add the user to the kvm group."
  end
end

qemu_dir = nil
if host == :linux_arm64
  qemu_dir = flth_env("FLTH_QEMU_DIR", %r{\A/[A-Za-z0-9._/ -]*\z}, "an absolute path")
  %w[edk2-aarch64-code.fd edk2-arm-vars.fd].each do |f|
    path = File.join(qemu_dir, f)
    raise "UEFI firmware #{path} is not readable (FLTH_FIRMWARE_CODE / FLTH_FIRMWARE_VARS)" unless File.readable?(path)
  end
end

Vagrant.configure("2") do |config|
  # The Linux box declares `config.vagrant.plugins = "vagrant-qemu"`.
  # Vagrant's check of that cannot see a plugin loaded from a bundler
  # Gemfile and stops to ask on a TTY, so the requirement is checked above
  # instead and this one is cleared.
  config.vagrant.plugins = {}

  case host
  when :macos_arm64
    if guest != "debian-12"
      raise "[vm] guest #{guest} has no macOS box: the macOS guest is Debian 12 " \
            "(Raspberry Pi OS bookworm). Run a debian-13 guest on a Linux host."
    end
    # A kernel with the common filesystem modules, booted directly: QEMU
    # loads it from beside the box, with no firmware and no bootloader.
    # generic/debian12 is NOT used: it was rebuilt upstream without its
    # \EFI\BOOT bootloader and no longer boots.
    config.vm.box = "christhomas/vagrant-rpi-bookworm-arm64"
    # Published as a public GitHub release, so the first boot on a Mac
    # fetches it and nobody adds a copy by hand (#8).
    config.vm.box_url = "https://github.com/christhomas/vagrant-rpi-bookworm-arm64/releases/download/v1.0.0/rpi-arm64.box"
  when :linux_arm64, :linux_x86_64
    # Built from Debian's official cloud images, qemu provider for both
    # architectures. Pinned so every run boots the same guest. Debian 12
    # is every consumer's unless its config names `[vm] guest`; Debian 13
    # is there for what 6.1 cannot do, a 6.12 kernel and xfsprogs 6.13.
    box, version = {
      "debian-12" => ["cloud-image/debian-12", "20260909.2596.0"],
      "debian-13" => ["cloud-image/debian-13", "20260914.2601.0"],
    }.fetch(guest)
    config.vm.box = box
    config.vm.box_version = version
  end
  config.vm.box_architecture = (host == :linux_x86_64 ? "amd64" : "arm64")
  config.vm.box_check_update = false
  config.vm.hostname = vm_name

  # A cold boot takes time. One that does not finish in it prints the
  # guest's console (console_args, above), not just the timeout.
  config.vm.boot_timeout = 600

  # The provider forwards SSH itself, using qe.ssh_port below. Its duplicate
  # high-level network record must not run Vagrant's connection-based collision
  # probe: some hosts accept connections even to unbound ports, which exhausts
  # the correction range and replaces our bind-selected port with an occupied
  # one. Disabled records bypass that probe; the QEMU provider still uses the
  # SSH record's host port. A genuine bind race is retried by the harness.
  config.vm.network :forwarded_port, guest: 22, host: Integer(ssh_port), id: "ssh", disabled: true

  config.vm.provider "qemu" do |qe|
    qe.memory = memory
    qe.smp = "cpus=#{cpus},sockets=1,cores=#{cpus},threads=1"
    qe.ssh_port = Integer(ssh_port)
    qe.ssh_auto_correct = true
    qe.disk_resize = disk

    # A DISPOSABLE BOOT NEVER WRITES THE MACHINE'S DISK. With snapshot=on
    # QEMU opens the disk read-only and sends every write to a temporary
    # overlay, created under TMPDIR (engine_up gives `vagrant up` the
    # harness's own) and unlinked as soon as it is open — so it is gone
    # when QEMU exits, however it exits, and a mount, a loop device or a
    # half-finished install a run leaves behind is gone with it. Only the
    # provisioning boot, which applies the consumer's setup script, runs
    # without it (scripts/vm.sh, provision_disk).
    #
    # discard=unmap LETS THE OVERLAY SHRINK (#105). QEMU's default ignores what
    # the guest says it has freed, so the overlay holds every block ever written
    # until the boot ends, and werror=enospc then pauses the guest when the host's
    # disk fills: a 14 GB runner lost its guest that way, on a suite whose guest
    # used about 6.5 GB. QEMU copies this option down to the overlay, which
    # gives the freed clusters back as holes. The guest's side of it is
    # guest/online-discard.sh, below. The provisioning boot is left out: nothing
    # it deletes grows anything, and the disk it writes is meant to be kept.
    qe.extra_drive_args = "snapshot=on,discard=unmap" if disposable

    case host
    when :macos_arm64
      qe.arch = "aarch64"
      qe.machine = "virt,accel=hvf,highmem=on"
      qe.cpu = "host"
      qe.net_device = "virtio-net-device"
      # The virtiofsd a run's tree is served by is the harness's own, started
      # with the flags this provider used for its folders
      # (scripts/lib/engine-vagrant.sh, engine_vagrant_virtiofsd_args).
      qe.extra_qemu_args = console_args + cache_args + kernel_args + hotplug_args
    when :linux_arm64
      qe.arch = "aarch64"
      qe.machine = "virt,accel=kvm,highmem=on"
      qe.cpu = "host"
      qe.net_device = "virtio-net-device"
      qe.qemu_dir = qemu_dir
    when :linux_x86_64
      qe.arch = "x86_64"
      qe.machine = "q35,accel=kvm"
      qe.cpu = "host"
      qe.net_device = "virtio-net-pci"
    end

    if host != :macos_arm64
      qe.extra_qemu_args = console_args + cache_args + display_args + hotplug_args +
                           (boot_cmdline.empty? ? [] : kernel_args)
    end
  end

  # Vagrant's default share could fall back to SMB, which prompts for
  # credentials and breaks a non-interactive `up`.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # NOTHING MAY HOLD THE PACKAGE MANAGER when the consumer's setup script
  # runs: it installs its tooling with apt, which fails at once on a held
  # lock. The macOS box's first-boot dialog (userconfig.service) waits for
  # a keyboard and holds the dpkg lock for ever; this disables it, then
  # waits out anything else and fails, naming the holder, if it will not
  # let go. First, so it precedes everything that follows a boot.
  config.vm.provision "apt-ready", type: "shell", run: "always",
                      path: "guest/apt-ready.sh"

  if disposable
    config.vm.provision "online-discard", type: "shell", run: "always",
                        path: "guest/online-discard.sh"
  end

  if host == :macos_arm64
    config.notify_forwarder.enable = true
    # BUT NOTHING IN THE GUEST MAY WRITE TO THE SHARES (#84). The plugin's guest
    # receiver at notify-forwarder v1.1.0 (src/inject_utimes.cc) answers an event
    # by opening the named file read-write: it writes the first byte of a file
    # back, and it writes a byte to a file it reads as empty and truncates it to
    # 0. A file the host is still writing is empty for a moment, so that
    # truncate reached the host and emptied a payload it had just finished.
    # Measured on an Apple Silicon host: 40 staged payloads drew 314 writes from
    # the receiver, and with the host's first write stalled and the guest reading
    # the share, 2 of 168 1048576-byte files ended at 0 bytes on the host, against
    # 0 of 168 with the receiver stopped. Nothing here needs host events in the
    # guest, so the plugin is given a receiver that exits. Its `binaries` setting
    # is the way in: the receiver starts after provisioning, so no provisioner can
    # stop it, and disabling the plugin stops the boot (above).
    #
    # IT STAYS OFF WITH v1.2.1, WHICH PLUGIN 0.7.7 INSTALLS (#87). v1.2.1 no longer
    # writes data: it opens the file write-only and sets and removes an extended
    # attribute, and 0 of 168 payloads and 0 of 992 captured streams came back wrong
    # with it running, against 11 and 35 with v1.1.0 in the same guest. But nothing
    # here needs host events, it would still change every file an event names
    # through the share, and as the plugin starts it on a boot it would do nothing:
    # the service starts before the shares are mounted and holds the directories
    # under them (vagrant-notify-forwarder#33).
    receiver_off = File.expand_path("guest/notify-receiver-off.sh", __dir__)
    config.notify_forwarder.binaries = {
      [:linux, :arm64] => ["file://#{URI::DEFAULT_PARSER.escape(receiver_off)}", Digest::SHA256.file(receiver_off).hexdigest],
    }
  end

  # The declared cache, at the same place on every boot. The guest gives
  # a new disk the filesystem its own root uses, so the harness names none.
  unless cache_disk.empty?
    config.vm.provision "cache", type: "shell", run: "always",
                        path: "guest/mount-cache.sh", args: [cache_serial, cache_guest]
  end

  # A DEADLINE THE HOST CANNOT FAIL TO ENFORCE. Every other teardown is
  # passive: `down` needs the caller's control flow to reach it, `reap`
  # needs a later chore invocation, and the watchdog needs a host process
  # that is still running. A host process that hangs holds a live VM
  # forever with every net behaving as written — it happened, for
  # thirteen hours. So the guest schedules its own poweroff at every boot.
  # `vm.sh hold` cancels it for a person working in the guest.
  config.vm.provision "deadline", type: "shell", run: "always",
                      path: "guest/deadline.sh", args: [deadline]
end
