#!/usr/bin/env perl
#
# A stand-in for virtiofsd, for the tests that drive the real engine (#222). It
# listens on --socket-path, as the daemon does before QEMU connects, and logs its
# arguments to <socket>.args. Like the real daemon it ends when the QEMU that connected
# goes away (#262), which here is the stand-in QMP closing its chardev. It also ends
# when it is signalled, or when the test that started it (FLTH_TEST_PID) has gone. How
# it ended is appended to FLTH_TEST_VFS_LOG when that is set: `client-left` or `term`.
use strict;
use warnings;
use IO::Select;
use IO::Socket::UNIX;
my ($sock) = map { /^--socket-path=(.*)/ ? $1 : () } @ARGV;
exit 2 unless defined $sock;
open my $args, ">", "$sock.args" or exit 1; print {$args} join("\n", @ARGV), "\n"; close $args;
my $server = IO::Socket::UNIX->new(Type => SOCK_STREAM(), Local => $sock, Listen => 1) or exit 1;
sub leave {
    my ($how) = @_;
    if ($how && $ENV{FLTH_TEST_VFS_LOG} && open my $log, ">>", $ENV{FLTH_TEST_VFS_LOG}) {
        print {$log} "$how\n";
        close $log;
    }
    unlink $sock;
    exit 0;
}
$SIG{TERM} = sub { leave("term") };
my $select = IO::Select->new($server);
my $client;
while (1) {
    for my $ready ($select->can_read(1)) {
        if ($ready == $server) {
            $client = $server->accept or next;
            $select->remove($server);
            $select->add($client);
        } else {
            leave("client-left") unless sysread($client, my $data, 4096);
        }
    }
    leave("") if $ENV{FLTH_TEST_PID} && !kill(0, $ENV{FLTH_TEST_PID});
}
